android_app {
    name: "LunarisDolby",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    overrides: ["MusicFX", "AudioFX"],
    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.compose.animation_animation",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "androidx.navigation_navigation-compose",
        "com.google.android.material_material",
        "kotlinx-coroutines-android",
        "kotlinx-coroutines-core",
    ],

    required: [
        "preinstalled-packages-platform-lunarisdolby.xml",
        "privapp-permissions-dolby.xml",
    ],
}

// Renamed from preinstalled-packages-platform-dolby.xml: hardware/xiaomi/dolby
// (XiaomiDolby, unused but always Soong-parsed since it's part of the
// hardware_xiaomi manifest project) defines a module with that exact name,
// which collides at Android.bp registration time regardless of whether
// XiaomiDolby is actually in PRODUCT_PACKAGES.
prebuilt_etc {
    name: "preinstalled-packages-platform-lunarisdolby.xml",
    src: "preinstalled-packages-platform-lunarisdolby.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-dolby.xml",
    src: "privapp-permissions-dolby.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
